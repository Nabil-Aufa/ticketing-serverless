        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#545B64;strokeWidth=2;fontSize=11;fontColor=#545B64;fontFamily=Arial;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="users" target="lambda">
